{
  "info": {
    "name": "Capsule Corp API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Inventario Dragon Ball (Express + PostgreSQL). Cambia la variable baseUrl para apuntar a local o a Render."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://capsule-corp-api-mc.onrender.com"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    },
    {
      "name": "Obtener producto",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "1"
          ]
        }
      }
    },
    {
      "name": "Crear producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Gravedad x100 (cámara)\",\n  \"categoria\": \"Entrenamiento\",\n  \"precio\": 75000,\n  \"stock\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    },
    {
      "name": "Actualizar producto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stock\": 7\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "1"
          ]
        }
      }
    },
    {
      "name": "Eliminar producto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "1"
          ]
        }
      }
    }
  ]
}
